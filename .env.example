# Supabase (server-side only for service role; anon URL/key if needed)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Google AI Studio (Gemini API - server-side only)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash-lite

# 3-Tier Hierarchical Session Auth
SESSION_SECRET=replace-with-random-32-char-secret
ENABLE_DEMO_ROLE_SWITCHER=true

# Optional WhatsApp Integration (Twilio Sandbox or Meta Cloud API; falls back to Local Simulator)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
WHATSAPP_VERIFY_TOKEN=campusfest-verify
